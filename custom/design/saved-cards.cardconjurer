                "type": {
                    "name": "Type",
                    "text": "Creature - Human Expeditioner Soldier",
                    "x": 0.08358208955223881,
                    "y": 0.5643212508884151,
                    "width": 0.8292,
                    "height": 0.0543,
                    "oneLine": true,
                    "font": "belerenb",
                    "size": 0.0324,
                    "fontSize": "-6"
                },
                "rules": {
                    "name": "Rules Text",
                    "text": "{i}Mutiny!{/i} - Whenever another Expeditioner creature you control dies, target opponent gains control of this creature.\nWhen this creature dies, create a Chroma token.{flavor}It’s a gutting realization, what has to be done. The mission is too important. The team is too important. We can’t just throw our lives away for nothing. I hate that it came to this, but he broke our trust.\n- Vincent, Expedition 48",
                    "x": 0.086,
                    "y": 0.6325515280739161,
                    "width": 0.828,
                    "height": 0.2875,
                    "size": 0.0362
                },
                "pt": {
