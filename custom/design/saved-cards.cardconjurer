                "type": {
                    "name": "Type",
                    "text": "Legendary Creature - Human Expeditioner Wizard",
                    "x": 0.0854,
                    "y": 0.5664,
                    "width": 0.8292,
                    "height": 0.0543,
                    "oneLine": true,
                    "font": "belerenb",
                    "size": 0.0324,
                    "fontSize": "-24"
                },
                "rules": {
                    "name": "Rules Text",
                    "text": "Lune can’t have more than four stain counters on her.\nWhenever you cast an instant or sorcery spell, draw a card and put a stain counter on Lune for each of that spell’s colors.\n{i}Tree of Life{/i} — {W}{G}, {T}, Remove a stain counter from Lune: Return target nonland, noncreature card from your graveyard to your hand. You gain 3 life.\n{i}Wildfire{/i} — {R}, {T}, Remove two stain counters from Lune: Lune deals 2 damage to each creature target opponent controls.\n{i}Elemental Genesis{/i} — {T}, Remove four stain counters from Lune: Lune deals 4 damage to each of up to two targets.{flavor}As long as even one of us stands, our fight is not over.",
                    "x": 0.086,
                    "y": 0.6303,
                    "width": 0.828,
                    "height": 0.2875,
                    "size": 0.0362
                },
                "pt": {
                    "name": "Power/Toughness",
