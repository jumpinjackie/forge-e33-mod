                "type": {
                    "name": "Type",
                    "text": "Sorcery - Gradient",
                    "x": 0.08358208955223881,
                    "y": 0.5643212508884151,
                    "width": 0.8292,
                    "height": 0.0543,
                    "oneLine": true,
                    "font": "belerenb",
                    "size": 0.0324
                },
                "rules": {
                    "name": "Rules Text",
                    "text": "Until end of turn, you may play lands and cast Nevron or Gradient spells from your graveyard.\nIf a card would be put into your graveyard from anywhere this turn, exile that card instead.{flavor}67 years. 67 years I spent trapped within the Monolith. But I persisted. I persisted. Do you know why? Do you know why I CANNOT leave her or you behind? This is what I see every day. I cannot spend another day with living corpses.\n- Renoir",
                    "x": 0.086,
                    "y": 0.6325515280739161,
                    "width": 0.828,
                    "height": 0.27149964463397297,
                    "size": 0.0362
