                    "oneLine": true,
                    "font": "belerenb",
                    "size": 0.0324,
                    "fontSize": "-4"
                },
                "rules": {
                    "name": "Rules Text",
                    "text": "When this creature dies, create a Chroma token.{flavor}Lumière operates a certain way. It favours a certain group and a certain outcome and if you question the Council, well, the Council’s going to question you.\nPush too hard to change things and you just might end up on the next Expedition.\nSo. Nothing ever changes. They just send us out to die. Dissenters. And the status quo continues. At least out here, I don’t have to pretend anymore.",
                    "x": 0.086,
                    "y": 0.6303,
                    "width": 0.828,
                    "height": 0.27292110874200426,
                    "size": 0.0362
                },
