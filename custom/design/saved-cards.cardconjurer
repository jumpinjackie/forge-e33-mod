                    "height": 0.0543,
                    "oneLine": true,
                    "font": "belerenb",
                    "size": 0.0324,
                    "fontSize": "-8"
                },
                "rules": {
                    "name": "Rules Text",
                    "text": "Saddle 2.\nEsquie has Islandwalk as long as you control a card named Florrie.\nEsquie has Flying as long as you control a card named Soarrie.\nEsquie has Trample as long as you control a card named Dorrie.\nWhen Esquie attacks, if you control a card named Urrie, Surveil 2.\nWhen Esquie attacks, if it is saddled, choose one —\n• Draw a card.\n• Put a land card from your hand onto the battlefield.\n",
                    "x": 0.086,
                    "y": 0.6325515280739161,
                    "width": 0.828,
                    "height": 0.2875,
                    "size": 0.0362
                },
