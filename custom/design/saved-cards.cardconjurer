                "rules": {
                    "name": "Rules Text",
                    "text": "Ward {3}\nMask Keeper enters with an anger counter, a joy counter and a sadness counter.\nAt the beginning of your upkeep, put an anger, joy or sadness counter on him.\n{i}Anger mask{/i} — Remove an anger counter from Mask Keeper: Untap him.\n{i}Joy mask{/i} — Remove a joy counter from Mask Keeper: Mask Keeper gains lifelink until end of turn.\n{i}Sadness mask{/i} — Remove a sadness counter from Mask Keeper: Put a stun counter on target creature.{flavor}We all need masks.",
                    "x": 0.086,
                    "y": 0.6303,
                    "width": 0.828,
                    "height": 0.2878464818763326,
                    "size": 0.0362
                },
