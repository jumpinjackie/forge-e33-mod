                "title": {
                    "name": "Title",
                    "text": "Gestral Climbing Challenge",
                    "x": 0.0854,
                    "y": 0.0522,
                    "width": 0.8292,
                    "height": 0.0543,
                    "oneLine": true,
                    "font": "belerenb",
