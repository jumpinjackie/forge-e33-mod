                },
                "type": {
                    "name": "Type",
                    "text": "Enchantment",
                    "x": 0.0854,
                    "y": 0.5664,
                    "width": 0.8292,
                    "height": 0.0543,
                    "oneLine": true,
                    "font": "belerenb",
                    "size": 0.0324
                },
                "rules": {
                    "name": "Rules Text",
                    "text": "Whenever a creature you control becomes tapped, you may put a quest counter on this Enchantment.\nAs long as there are two or more quest counters on this enchantment. Creatures you control have reach.\nAs long as there are four or more quest counters on this enchantment. You may play an additional land on each of your turns.{flavor}I’ve been trying to overcome this gestral’s challenge for months now but it seems even more of a challenge than defeating the Paintress. I guess I’ll never see the Gestral’s grand prize. That’s my only regret in life.\n- Laure, Expedition 37",
                    "x": 0.086,
                    "y": 0.6303,
                    "width": 0.828,
                    "height": 0.2875,
                    "size": 0.0362
                },
