                    "oneLine": true,
                    "font": "belerenb",
                    "size": 0.0324
                },
                "rules": {
                    "name": "Rules Text",
                    "text": "{i}Not happy{/i} — When this creature enters, create a blue Aura enchantment token named Barbapapa attached to another target creature. The token has enchant creature and “Enchanted creature has base power 1. When enchanted creature deals combat damage, sacrifice this Aura.”\n{i}Lollipop attack{/i} — This creature gets +1/+1 as long as you control at least two Foods.\n{i}Summons flying candy{/i} — Sacrifice a Food: This creature deals 2 damage to target creature with flying.\n{i}Candy shields{/i} — Sacrifice a Food: Put a shield counter on this creature.",
                    "x": 0.086,
                    "y": 0.6303,
                    "width": 0.828,
                    "height": 0.2875,
